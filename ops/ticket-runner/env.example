# Envs del runner "Resolver con Claude". En Dokploy van en la pestaña
# Environment del servicio. NUNCA commitear valores reales.

# URL pública del app empleaIA.
APP_BASE_URL=https://app.empleaia.es

# Mismo secreto HMAC que el app (var EMPLEAIA_SIGNING_SECRET en empleaia-app).
EMPLEAIA_SIGNING_SECRET=

# Token OAuth de la suscripción de Claude. Generar con `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# PAT fine-grained de la cuenta bot aiabot: Contents R/W + PR R/W, scope solo
# al repo empleaia-app. SIN permiso de merge/admin.
GH_TOKEN=

# Identidad de los commits/PRs del bot.
GIT_AUTHOR_NAME=aiabot
GIT_AUTHOR_EMAIL=aiabot@users.noreply.github.com

REPO_SLUG=AgentesIA-MAdrid/empleaia-app
# Rama base (worktree + --base del PR). Prod corre feature/saas-migration.
BASE_BRANCH=feature/saas-migration
CLAUDE_MODEL=opus
POLL_INTERVAL_MS=15000
JOB_TIMEOUT_MS=1800000
HEARTBEAT_MS=60000

# 1 = plumbing test (no invoca Claude). 0 = resolución real.
CLAUDE_RUNNER_STUB=0

# Time-tracking del agente en /agency/time del portal (sale como técnico). La
# key identifica al agente: este runner es "Claudia", y su entrada tiene que
# estar dada de alta en TIME_TRACKER_KEYS del portal (`claudia:<key>`).
# Sin AGENTESIA_TRACKER_KEY el hook no envía nada y Claudia no aparece.
AGENTESIA_TRACKER_URL=https://app.agentesialabs.com
AGENTESIA_TRACKER_KEY=
# Opcional; por defecto el hostname del contenedor.
AGENTESIA_TRACKER_MACHINE=

# Nº de réplicas (cada una ~3 GB en pico + cuota OAuth). Default 1.
RUNNER_REPLICAS=1
