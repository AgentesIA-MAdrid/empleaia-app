{
  "$comment": "Deny-list del runner headless. La frontera real es la infra (worktree efímero, non-root, ruleset 'Protect main'/rama base require PR+approval con el bot sin bypass) + el no-merge del orquestador (solo gh pr create). Esto es defensa en profundidad: bloquea lo catastrófico aunque skip-permissions esté activo.",
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /home:*)",
      "Bash(sudo:*)",
      "Bash(curl:*EMPLEAIA_SIGNING_SECRET*)"
    ]
  },
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "node /home/runner/app/claude-time-hook.mjs", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node /home/runner/app/claude-time-hook.mjs", "timeout": 10 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "node /home/runner/app/claude-time-hook.mjs", "timeout": 10 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "node /home/runner/app/claude-time-hook.mjs", "timeout": 10 }] }]
  }
}
