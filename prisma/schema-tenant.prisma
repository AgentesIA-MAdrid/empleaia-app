// Schema Prisma del producto (modelos por tenant). Fase 3 — ADR-002 §2.2.
//
// Diseño intencional:
// - SIN multiSchema. Sin `schemas = [...]` en datasource y sin `@@schema(...)`
//   en los modelos. Esto fuerza a Prisma a NO cualificar el schema en el SQL
//   generado (los queries serán `SELECT * FROM "User"` sin prefijo de schema).
// - El cliente `prismaApp` aplicará `SET search_path TO "tenant_<slug>", public`
//   por query mediante `$extends({ query })`. Como las queries no llevan schema
//   cualificado, search_path las dirige al schema del tenant en runtime.
// - Las migraciones de este schema se aplican primero a un schema fijo
//   `tenant_template` (commits 11-12). Después se replican a cada
//   `tenant_<slug>` con `tenants:migrate <slug>` (commit 13) y `tenants:migrate:all`
//   (commit 14).
// - Las tablas del control plane (master.*) viven en `prisma/schema.prisma`
//   con su propio cliente (`prismaMaster`, `prismaRuntime`, `prismaQuotaWriter`).
//   Estos dos clientes son independientes — no comparten modelos ni
//   relaciones cross-schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-tenant"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum Rol {
  OWNER
  MANAGER
  EMPLEADO
}

enum TipoFichaje {
  ENTRADA
  PAUSA
  VUELTA_PAUSA
  SALIDA
}

enum MetodoFichaje {
  WEB
  MOVIL
  TABLET
  MANUAL
}

enum EstadoAusencia {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

enum EstadoTurno {
  BORRADOR
  PUBLICADO
}

enum EstadoSolicitudFichaje {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

enum EstadoPrenomina {
  BORRADOR
  CERRADA
  ENVIADA
}

enum TipoConceptoPrenomina {
  DIETA
  KILOMETRAJE
  COMISION
  PLUS
  BONUS
  DEDUCCION
  OTRO
}

// ─── Modelos del producto ──────────────────────────────────────────────────────

model Tienda {
  id                  String            @id @default(cuid())
  nombre              String
  direccion           String
  ciudad              String
  codigoPostal        String?
  telefono            String?
  email               String?
  latitud             Float?
  longitud            Float?
  radio               Int               @default(200)
  /// Exige fichar dentro del `radio` de la sede. Fuera de él, el fichaje
  /// directo se rechaza y el empleado solo puede registrarlo explicando el
  /// motivo: eso crea una SolicitudFichaje PENDIENTE (clase "fuera_sede")
  /// que un OWNER aprueba. La jornada nunca se pierde (RD 8/2019), pero
  /// queda marcada y bajo control del administrador. Requiere coordenadas
  /// en la sede: sin ellas no hay distancia que comparar y no se aplica.
  exigirFichajeEnSede Boolean           @default(false)
  activa              Boolean           @default(true)
  color               String            @default("#6366f1")
  // Marca la sede que hace de "oficina": destino del relleno automático del
  // cuadrante (ver `User.turnoOficinaPorDefecto`). Solo una sede debería
  // tenerlo activo; la API lo garantiza al guardar.
  //
  // Además (ticket 9d4e17c2): en la oficina no se cierra turno ni se firman los
  // puntos de control al fichar. Es trabajo de oficina, no de tienda, y quien
  // ficha ahí —sea del rol que sea— no tiene caja que cuadrar ni stock que
  // revisar.
  esOficina           Boolean           @default(false) @map("es_oficina")
  /// Día de la semana en el que esta sede prepara el arqueo, en numeración ISO
  /// (1 = lunes … 7 = domingo). Es el ÚLTIMO día que abre: las tiendas de centro
  /// comercial abren el domingo y arquean ese día; las de calle cierran el
  /// sábado y arquean entonces, porque el domingo no hay nadie que cuente el
  /// dinero (ticket 2c9d84f1).
  arqueoDiaSemana     Int               @default(7) @map("arqueo_dia_semana")
  /// La sede vende, pero el dinero NO es nuestro: lo liquida un tercero (el
  /// caso de un córner en unos grandes almacenes, que factura él y liquida
  /// después — ticket 9d4e17c2).
  ///
  /// Su cierre de turno es el de siempre en las VENTAS, pero el paso de caja no
  /// pide efectivo ni tarjeta: pide el stock y los tickets de las ventas
  /// facturadas, que se cuadran luego contra la liquidación del tercero. Y queda
  /// fuera de arqueos y de conciliación bancaria: no hay efectivo que apartar ni
  /// ingreso nuestro que casar.
  sinEfectivo         Boolean           @default(false) @map("sin_efectivo")
  // Responsable de la sede (dato informativo / de visualización). NO altera
  // la jerarquía de aprobaciones: el coordinador que aprueba fichajes sigue
  // siendo `User.managerId` (relación ManagerSubordinados). Relación propia
  // (TiendaManager), independiente de `empleados`/`User.tiendaId`.
  managerId           String?
  manager             User?             @relation("TiendaManager", fields: [managerId], references: [id])
  empleados           User[]
  fichajes            Fichaje[]
  turnos              Turno[]
  // Horarios de apertura: N tramos por día (sin filas para un día = cerrado).
  horarios            HorarioSede[]
  /// Fondo de caja por fecha (ticket 7ab2c5d9).
  fondosCaja          FondoCaja[]
  // Multi-sede: empleados asignados a esta sede (N:N vía UsuarioSede).
  miembros            UsuarioSede[]
  // Festivos locales que aplican solo a esta sede.
  festivos            Festivo[]
  // ── Cierre de turno (plan Enterprise) ──────────────────────────────────
  cierresTurno        CierreTurno[]
  arqueos             Arqueo[]
  movimientosBanco    MovimientoBanco[]
  facturacion         MovimientoFacturacion[]
  objetivosVenta      ObjetivoVenta[]
  // Grupos de objetivos a los que pertenece la sede (TMT, zona…).
  gruposObjetivo      GrupoObjetivoMiembro[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([managerId])
}

// Horario de apertura de una sede. Una fila = un tramo de un día.
// Modelo flexible: 0 tramos en un día = cerrado; N tramos = horario
// partido o múltiples franjas. diaSemana: 0=lunes … 6=domingo.
model HorarioSede {
  id           String   @id @default(cuid())
  tiendaId     String   @map("tienda_id")
  tienda       Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  diaSemana    Int      @map("dia_semana")
  horaApertura String   @map("hora_apertura")
  horaCierre   String   @map("hora_cierre")
  orden        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([tiendaId])
}

// Pertenencia empleado↔sede (N:N). `principal` marca la sede que se
// refleja en `User.tiendaId` (la usada por turnos/fichaje/informes).
model UsuarioSede {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiendaId  String   @map("tienda_id")
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  principal Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, tiendaId])
  @@index([userId])
  @@index([tiendaId])
}

model User {
  id                         String                     @id @default(cuid())
  email                      String                     @unique
  password                   String?
  resetToken                 String?                    @unique
  resetTokenExpiry           DateTime?
  nombre                     String
  apellidos                  String
  dni                        String?                    @unique
  telefono                   String?
  foto                       String?
  fechaNacimiento            DateTime?
  rol                        Rol                        @default(EMPLEADO)
  tiendaId                   String?
  tienda                     Tienda?                    @relation(fields: [tiendaId], references: [id])
  activo                     Boolean                    @default(true)
  // Anonimización (borrado RGPD-compatible): cuando se "elimina" un empleado
  // no se hace hard-delete (rompería FKs y borraría registros legales como
  // fichajes/nóminas que hay que conservar). Se ponen a null sus datos
  // personales, activo=false y esta marca con la fecha. Los listados de
  // empleados filtran `anonimizadoAt: null`.
  anonimizadoAt              DateTime?                  @map("anonimizado_at")
  fichajes                   Fichaje[]
  turnos                     Turno[]
  ausencias                  Ausencia[]                 @relation("AusenciaEmpleado")
  ausenciasAprobadas         Ausencia[]                 @relation("AusenciaAprobador")
  notificaciones             Notificacion[]
  tareas                     Tarea[]                    @relation("TareaAsignada")
  tareasCreadas              Tarea[]                    @relation("TareaCreada")
  comunicados                Comunicado[]
  articulos                  Articulo[]
  documentos                 Documento[]                @relation("DocumentoEmpleado")
  documentosSubidos          Documento[]                @relation("DocumentoSubido")
  plantillasDocumento        PlantillaDocumento[]       @relation("PlantillaCreador")
  firmas                     Firma[]                    @relation("FirmaUsuario")
  onboardings                ProcesoOnboarding[]
  bolsaHoras                 BolsaHoras[]
  bolsaHorasAprobadas        BolsaHoras[]               @relation("BolsaHorasAprobador")
  denunciasInformante        Denuncia[]                 @relation("DenunciaInformante")
  denunciasAsignadas         Denuncia[]                 @relation("DenunciaAsignada")
  comentariosDenuncia        ComentarioDenuncia[]       @relation("ComentarioDenunciaAutor")
  solicitudesFirmaRecibidas  SolicitudFirma[]           @relation("SolicitudFirmaDestinatario")
  solicitudesFirmaCreadas    SolicitudFirma[]           @relation("SolicitudFirmaSolicitante")
  // Organigrama: jerarquía de mando self-reference.
  managerId                  String?
  manager                    User?                      @relation("ManagerSubordinados", fields: [managerId], references: [id])
  subordinados               User[]                     @relation("ManagerSubordinados")
  // Sedes de las que este usuario figura como responsable (dato informativo;
  // ver Tienda.managerId). No interviene en aprobaciones ni organigrama.
  sedesGestionadas           Tienda[]                   @relation("TiendaManager")
  // Reclutamiento: usuarios que crearon ofertas / gestionan candidatos.
  ofertasCreadas             OfertaTrabajo[]            @relation("OfertaCreador")
  candidatosCreados          Candidato[]                @relation("CandidatoCreador")
  // Asistente IA: conversaciones del usuario.
  conversacionesIA           ConversacionIA[]           @relation("ConversacionIAUser")
  // Face ID: plantilla biométrica (opcional, máx 1 por usuario).
  faceTemplate               FaceTemplate?              @relation("FaceTemplateUser")
  preferenciasNotificacion   PreferenciasNotificacion?
  pushSubscripciones         PushSubscripcion[]
  // OKRs: objetivos asignados / creados por el usuario.
  objetivosAsignados         Objetivo[]                 @relation("ObjetivoAsignado")
  objetivosCreados           Objetivo[]                 @relation("ObjetivoCreado")
  // Encuestas de clima: encuestas creadas + respuestas dadas.
  encuestasCreadas           Encuesta[]                 @relation("EncuestaCreador")
  respuestasEncuesta         RespuestaEncuesta[]        @relation("RespuestaEncuestaUser")
  // Evaluaciones del desempeño: como evaluado, como evaluador.
  evaluacionesRecibidas      Evaluacion[]               @relation("EvaluacionEvaluado")
  evaluacionesARealizar      Evaluacion[]               @relation("EvaluacionEvaluador")
  // Control de gastos: tickets registrados.
  gastos                     Gasto[]
  gastosRevisados            Gasto[]                    @relation("GastoRevisor")
  // Reserva de espacios: mis reservas.
  reservasEspacios           ReservaEspacio[]
  // Envío de nóminas: archivos subidos a cada empleado.
  nominasArchivos            NominaArchivo[]            @relation("NominaArchivoEmpleado")
  nominasArchivosSubidos     NominaArchivo[]            @relation("NominaArchivoSubidoPor")
  // Formación LMS: cursos creados, asignaciones recibidas.
  cursosCreados              Curso[]                    @relation("CursoCreador")
  cursosAsignados            AsignacionCurso[]          @relation("AsignacionCursoEmpleado")
  // Correcciones del cuadrante (ticket c1e94a7b): las que le afectan y las que
  // ha hecho él.
  fondosCajaRegistrados      FondoCaja[]                @relation("FondoCajaRegistradoPor")
  correccionesRecibidas      CorreccionCuadrante[]      @relation("CorreccionCuadranteEmpleado")
  correccionesHechas         CorreccionCuadrante[]      @relation("CorreccionCuadranteAutor")
  // Custom requests: peticiones del empleado, gestionadas por OWNER/MANAGER.
  peticiones                 Peticion[]                 @relation("PeticionSolicitante")
  peticionesGestionadas      Peticion[]                 @relation("PeticionGestor")
  // Solicitudes de fichaje (olvido / corrección de hora) del empleado y
  // las que resuelve como aprobador (coordinador / OWNER / MANAGER).
  solicitudesFichaje         SolicitudFichaje[]         @relation("SolicitudFichajeSolicitante")
  solicitudesFichajeResolver SolicitudFichaje[]         @relation("SolicitudFichajeAprobador")
  // Chat: participaciones + mensajes enviados.
  conversaciones             ParticipanteConversacion[]
  mensajesEnviados           Mensaje[]                  @relation("MensajeAutor")
  // Multi-empresa: el usuario puede asociarse a una empresa concreta.
  empresaId                  String?
  empresa                    Empresa?                   @relation(fields: [empresaId], references: [id])
  // Retribución flexible: declaraciones mensuales del empleado.
  declaracionesFlex          DeclaracionFlex[]
  // Prenómina: snapshots mensuales del empleado + cierres realizados.
  prenominas                 Prenomina[]                @relation("PrenominaEmpleado")
  prenominasCerradas         Prenomina[]                @relation("PrenominaCerrador")
  prenominasEnviadas         Prenomina[]                @relation("PrenominaEnviador")
  // Salario base mensual del empleado. Si null, se usa
  // `ConfiguracionEmpresa.nominaSalarioBaseDefault` al calcular prenómina.
  salarioBase                Decimal?                   @map("salario_base") @db.Decimal(10, 2)
  // Horas semanales contratadas del empleado (columna "HORAS A CONTRATO"
  // del cuadrante). Si null, se usa `ConfiguracionEmpresa.horasSemanales`.
  horasSemanalesContrato     Decimal?                   @map("horas_semanales_contrato") @db.Decimal(5, 2)
  // Relleno automático del cuadrante: si true, los días de la semana en que
  // este empleado no tenga turno en ninguna sede (ni ausencia aprobada) se
  // asignan solos a un turno 09:00–17:00 en la sede marcada como oficina
  // (`Tienda.esOficina`). Ver src/lib/turnos/oficina-por-defecto.ts.
  turnoOficinaPorDefecto     Boolean                    @default(false) @map("turno_oficina_por_defecto")
  // Marca si el empleado/manager ya rellenó sus datos personales
  // obligatorios (bloque personal + dirección + contacto) en su primer
  // acceso. El OWNER queda exento del flujo. La lista exacta de campos
  // obligatorios vive en `src/lib/empleados/perfil.ts`.
  perfilCompletado           Boolean                    @default(false) @map("perfil_completado")

  // ─── Ficha de empleado ampliada (RR.HH.) ───────────────────────────
  // Identificación (el número principal es `dni`).
  tipoIdentificacion             String?              @map("tipo_identificacion")
  tipoIdentificacionSecundaria   String?              @map("tipo_identificacion_secundaria")
  numeroIdentificacionSecundaria String?              @map("numero_identificacion_secundaria")
  // Información personal.
  nacionalidad                   String?
  estadoCivil                    String?              @map("estado_civil")
  genero                         String?
  compartirCumpleanos            Boolean              @default(true) @map("compartir_cumpleanos")
  // Dirección.
  domicilio                      String?
  codigoPostal                   String?              @map("codigo_postal")
  localidad                      String?
  provincia                      String?
  pais                           String?              @default("España")
  // Contacto (`telefono` se conserva como teléfono personal).
  emailEmpresa                   String?              @map("email_empresa")
  emailPersonal                  String?              @map("email_personal")
  emailNotificaciones            String?              @map("email_notificaciones")
  telefonoEmpresa                String?              @map("telefono_empresa")
  telefonoEmergencia             String?              @map("telefono_emergencia")
  contactoUrgencia               String?              @map("contacto_urgencia")
  // Datos de afiliación.
  teletrabajo                    Boolean              @default(false)
  grupoCotizacion                String?              @map("grupo_cotizacion")
  categoriaProfesional           String?              @map("categoria_profesional")
  numeroSeguridadSocial          String?              @map("numero_seguridad_social")
  codigoContrato                 String?              @map("codigo_contrato")
  // Fecha de alta del contrato (antigüedad RR.HH.). Se fija a mano: NO es
  // `createdAt` (alta del registro en la app). Solo la edita el OWNER; la
  // ven empleado, manager y OWNER.
  fechaAltaContrato              DateTime?            @map("fecha_alta_contrato")
  // Datos para retenciones.
  numeroHijos                    Int?                 @map("numero_hijos")
  porcentajeDiscapacidad         Int?                 @map("porcentaje_discapacidad")
  // Datos bancarios.
  titularCuenta                  String?              @map("titular_cuenta")
  iban                           String?
  bic                            String?
  entidadBancaria                String?              @map("entidad_bancaria")
  // Multi-sede: pertenencia a varias sedes (N:N). `tiendaId` sigue
  // siendo la sede principal y la fuente para turnos/fichaje/informes.
  sedes                          UsuarioSede[]
  // Festivos que se le han "quitado" (días que trabaja pese al festivo).
  festivoExcepciones             FestivoExcepcion[]
  // Campos personalizados: valores de cada campo definido por el tenant.
  camposPersonalizados           ValorCampoEmpleado[]

  // ── Cierre de turno (plan Enterprise) ──────────────────────────────────
  cierresTurno         CierreTurno[]       @relation("CierreTurnoEmpleado")
  cierresCajaEditados  CierreCajaEdicion[] @relation("CierreCajaEditor")
  objetivosVenta       ObjetivoVenta[]     @relation("ObjetivoVentaComercial")
  // Grupos de objetivos a los que pertenece la persona (TMT, equipo…).
  gruposObjetivo       GrupoObjetivoMiembro[]
  arqueosRecogidos     Arqueo[]            @relation("ArqueoRecogidoPor")
  /// Puede firmar la recogida del efectivo de un arqueo. Se marca desde
  /// administración; el rol por sí solo no habilita (un coordinador puede
  /// no recoger caja y un OWNER puede no pasar nunca por la tienda).
  puedeRecogerEfectivo Boolean             @default(false) @map("puede_recoger_efectivo")
  /// Hash del PIN de recogida (bcrypt). NUNCA el PIN en claro. Se fija y se
  /// resetea desde administración; null = sin PIN, no puede firmar.
  pinRecogidaHash      String?             @map("pin_recogida_hash")
  /// Fallos consecutivos de PIN. Se pone a 0 al acertar o al cambiarlo.
  pinRecogidaIntentos  Int                 @default(0) @map("pin_recogida_intentos")
  /// Hasta cuándo está bloqueada la firma por fallos seguidos. Es un bloqueo
  /// temporal y no una cuenta cerrada: quien recoge el dinero está en la
  /// tienda y no puede quedarse sin poder firmar por teclear mal dos veces.
  pinRecogidaBloqueoHasta DateTime?        @map("pin_recogida_bloqueo_hasta")
  /// Ve el módulo de cierre de turno aunque el cliente lo tenga EN RODAJE
  /// (`ConfiguracionEmpresa.cierreTurnoEnRodaje`). Sirve para estrenarlo con
  /// una persona concreta —la que se presta a probarlo en su tienda— sin
  /// abrírselo a la plantilla y sin tener que hacerla administradora, que le
  /// daría acceso a nóminas y al resto de la administración.
  cierreTurnoPiloto    Boolean             @default(false) @map("cierre_turno_piloto")
  arqueosDeclarados    Arqueo[]            @relation("ArqueoDeclaradoPor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tiendaId])
}

model Fichaje {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  tiendaId        String?
  tienda          Tienda?            @relation(fields: [tiendaId], references: [id])
  tipo            TipoFichaje
  timestamp       DateTime           @default(now())
  latitud         Float?
  longitud        Float?
  distancia       Float?
  metodo          MetodoFichaje      @default(WEB)
  nota            String?
  editadoPor      String?
  editadoEn       DateTime?
  ip              String?
  // Snapshot del rostro cifrado (AES-256-GCM, key IA_ENCRYPTION_KEY).
  // Solo se rellena cuando ConfiguracionEmpresa.faceIdGuardarFoto=true
  // y el fichaje viene del flujo Face ID.
  fotoSnapshotEnc Bytes?             @map("foto_snapshot_enc")
  // Puntos de control confirmados por el empleado al fichar (checklist
  // de entrada/salida configurado por el OWNER). Vacío si el tenant no
  // tiene el checklist activo.
  checklist       FichajeChecklist[]
  createdAt       DateTime           @default(now())

  @@index([userId])
  @@index([tiendaId])
  @@index([timestamp])
}

/// Punto de control que el empleado debe confirmar antes de fichar
/// (solo ENTRADA y SALIDA). Lo configura el OWNER en
/// /admin/configuracion?tab=checklist. Se muestra únicamente si
/// `ConfiguracionEmpresa.checklistFichajeActivo` está activo.
model ChecklistFichajeItem {
  id         String             @id @default(cuid())
  tipo       TipoFichaje
  texto      String
  orden      Int                @default(0)
  activo     Boolean            @default(true)
  respuestas FichajeChecklist[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([tipo, orden])
}

/// Confirmación de un punto de control en un fichaje concreto. Guarda
/// el enunciado como snapshot (`texto`): si el OWNER edita o borra el
/// item después, el registro histórico sigue siendo legible.
model FichajeChecklist {
  id        String                @id @default(cuid())
  fichajeId String
  fichaje   Fichaje               @relation(fields: [fichajeId], references: [id], onDelete: Cascade)
  itemId    String?
  item      ChecklistFichajeItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  texto     String
  orden     Int                   @default(0)
  marcado   Boolean               @default(true)
  createdAt DateTime              @default(now())

  @@index([fichajeId])
  @@index([itemId])
}

model Turno {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  tiendaId              String
  tienda                Tienda      @relation(fields: [tiendaId], references: [id])
  // Tipo de turno del catálogo del cliente (Mañana, Tarde, Doble…).
  // Opcional: un turno puede ser un rango a medida sin tipo asociado.
  tipoTurnoId           String?
  tipoTurno             TipoTurno?  @relation(fields: [tipoTurnoId], references: [id])
  fecha                 DateTime
  horaInicio            String
  horaFin               String
  nota                  String?
  estado                EstadoTurno @default(BORRADOR)
  // true si lo generó el relleno automático de oficina (ver
  // `User.turnoOficinaPorDefecto`). Distingue estos turnos de los creados a
  // mano para poder retirarlos cuando el día pasa a cubrirse en una tienda.
  generadoAuto          Boolean     @default(false) @map("generado_auto")
  // Marca de cuándo se envió el aviso de "olvido de fichaje" para este turno
  // (null = aún no enviado). Evita avisar repetidamente en cada pasada del cron.
  avisoFichajeEnviadoAt DateTime?   @map("aviso_fichaje_enviado_at")
  /// El turno se ha corregido desde el cuadro de discrepancias del informe
  /// (ticket c1e94a7b): o se creó a partir de un fichaje que no tenía turno, o
  /// se le cambió la sede para que cuadrara con dónde se fichó, o se marcó como
  /// no realizado. Se pinta en AMARILLO en el cuadrante para que se vea de un
  /// golpe qué se ha tocado a mano.
  corregido             Boolean     @default(false)
  /// El turno estaba publicado pero no se trabajó (nadie fichó) y se ha
  /// confirmado al corregir. Sigue en el cuadrante —no se borra, para no perder
  /// de vista lo que estaba previsto— pero sus horas NO cuentan en el informe de
  /// horas: salen aparte, en la hoja de incidencias.
  noRealizado           Boolean     @default(false) @map("no_realizado")
  /// Lo que decía el cuadrante antes de la corrección, en texto, para poder
  /// contarlo sin ir al historial ("Estaba en NEKSUS CARTAGENA 10:00-17:00").
  notaCorreccion        String?     @map("nota_correccion")
  correcciones          CorreccionCuadrante[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([tiendaId])
  @@index([tipoTurnoId])
  @@index([fecha])
  @@index([corregido])
}

/// Historial de correcciones del cuadrante hechas desde el cuadro de
/// discrepancias del informe (ticket c1e94a7b).
///
/// Se guarda el ANTES en texto y no por referencia: el turno se puede volver a
/// tocar o la sede desaparecer, y el historial tiene que seguir contando lo que
/// pasó. Es un registro de auditoría, no una vista.
model CorreccionCuadrante {
  id       String   @id @default(cuid())
  /// Turno resultante (creado o modificado). null si se borró después.
  turnoId  String?  @map("turno_id")
  turno    Turno?   @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  /// Empleado al que le afecta la corrección.
  userId   String   @map("user_id")
  user     User     @relation("CorreccionCuadranteEmpleado", fields: [userId], references: [id], onDelete: Cascade)
  /// Día corregido, a medianoche.
  fecha    DateTime @db.Date
  /// "sede_distinta" | "sin_turno" | "turno_sin_fichaje"
  tipo     String
  /// Qué decía el cuadrante antes ("NEKSUS CARTAGENA 10:00-17:00" o "sin turno").
  antes    String
  /// Qué dice después.
  despues  String
  /// Quién lo corrigió.
  corregidoPorId String @map("corregido_por_id")
  corregidoPor   User   @relation("CorreccionCuadranteAutor", fields: [corregidoPorId], references: [id])
  createdAt      DateTime @default(now())

  @@index([fecha])
  @@index([userId])
}

// Catálogo de tipos de turno que cada cliente define (Mañana, Tarde,
// Doble, M/T, Libre, rangos a medida…). Análogo a TipoAusencia.
model TipoTurno {
  id          String   @id @default(cuid())
  nombre      String
  // Etiqueta corta que se pinta en la celda del cuadrante: "M", "DOBLE",
  // "M/T", "LIBRE", o el rango. Si vacía, se usa `nombre`.
  abreviatura String   @default("")
  color       String   @default("#6366f1")
  // Rango horario por defecto del tipo (opcional; los turnos a medida
  // pueden sobrescribirlo en el propio Turno).
  horaInicio  String?
  horaFin     String?
  // Horas que computa este turno (Mañana=6, Doble=12, M/T=7, Libre=0).
  horas       Decimal  @default(0) @db.Decimal(5, 2)
  // Marca un turno de descanso ("LIBRE"): computa 0 horas.
  esLibre     Boolean  @default(false)
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  turnos      Turno[]
  createdAt   DateTime @default(now())
}

model TipoAusencia {
  id                 String     @id @default(cuid())
  nombre             String
  color              String     @default("#6366f1")
  icono              String     @default("calendar")
  pagada             Boolean    @default(true)
  requiereAprobacion Boolean    @default(true)
  diasMaximos        Int?
  ausencias          Ausencia[]
  activo             Boolean    @default(true)
  createdAt          DateTime   @default(now())
}

model Ausencia {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation("AusenciaEmpleado", fields: [userId], references: [id])
  tipoAusenciaId  String
  tipoAusencia    TipoAusencia   @relation(fields: [tipoAusenciaId], references: [id])
  fechaInicio     DateTime
  fechaFin        DateTime
  dias            Int
  motivo          String?
  estado          EstadoAusencia @default(PENDIENTE)
  aprobadoPorId   String?
  aprobadoPor     User?          @relation("AusenciaAprobador", fields: [aprobadoPorId], references: [id])
  aprobadoEn      DateTime?
  comentarioAdmin String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([fechaInicio])
}

/// Catálogo de tipos/carpetas de documentos del tenant (gestionable por el
/// OWNER). `Documento.tipo` guarda el `slug` de uno de estos (acoplamiento
/// laxo por string para no romper documentos con tipos antiguos).
model TipoDocumento {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  orden     Int      @default(0)
  createdAt DateTime @default(now())
}

model Notificacion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  titulo    String
  mensaje   String
  tipo      String   @default("info")
  leida     Boolean  @default(false)
  enlace    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Solicitud del empleado para registrar un fichaje olvidado o corregir la
/// hora de uno existente, sujeta a aprobación de su coordinador (managerId)
/// o, en su defecto, de un OWNER/MANAGER de su tienda. Al aprobarse se crea
/// o ajusta el `Fichaje` correspondiente como `MANUAL`.
model SolicitudFichaje {
  id                  String                 @id @default(cuid())
  solicitanteId       String
  solicitante         User                   @relation("SolicitudFichajeSolicitante", fields: [solicitanteId], references: [id])
  /// Coordinador notificado (managerId del solicitante en el momento de crear).
  /// Informativo: la resolución la puede hacer cualquier OWNER/MANAGER con scope.
  aprobadorId         String?
  aprobador           User?                  @relation("SolicitudFichajeAprobador", fields: [aprobadorId], references: [id])
  /// "olvido" = registrar un fichaje que no existía;
  /// "correccion" = corregir la hora de un fichaje existente (fichajeId).
  clase               String                 @default("olvido")
  tipo                TipoFichaje
  /// Fichaje a corregir cuando clase = "correccion".
  fichajeId           String?
  /// Hora propuesta de entrada/salida/pausa.
  fechaHora           DateTime
  motivo              String
  estado              EstadoSolicitudFichaje @default(PENDIENTE)
  respuesta           String?
  resueltaPorId       String?
  resueltaEn          DateTime?
  /// Geolocalización del intento, solo en clase "fuera_sede": se guarda aquí
  /// porque el Fichaje aún no existe, y se copia al fichaje resultante al
  /// aprobar. `distancia` en metros, calculada en servidor.
  latitud             Float?
  longitud            Float?
  distancia           Int?
  /// Fichaje creado o editado al aprobar la solicitud.
  fichajeResultanteId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([solicitanteId])
  @@index([aprobadorId])
  @@index([estado])
}

model ConfiguracionEmpresa {
  id                          String   @id @default(cuid())
  nombre                      String   @default("Mi Empresa")
  logo                        String?
  horasJornadaDiaria          Float    @default(8)
  horasSemanales              Float    @default(40)
  toleranciaFichaje           Int      @default(15)
  geofencingActivo            Boolean  @default(true)
  // Si true, el fichaje requiere geolocalización (lat/lon). Si false,
  // se acepta sin geo y el cliente puede saltarse la captura GPS.
  geoObligatoria              Boolean  @default(false) @map("geo_obligatoria")
  fichajeMovilActivo          Boolean  @default(true)
  fichajeTabletActivo         Boolean  @default(true)
  // Si true, los empleados con Face ID registrado deben verificarlo
  // al fichar (no se permite fichar sin Face ID si lo tienen).
  faceIdObligatorio           Boolean  @default(false) @map("face_id_obligatorio")
  // Si true, al fichar con Face ID guardamos un snapshot cifrado del
  // frame de la cámara (en Fichaje.fotoSnapshotEnc) para auditoría.
  // Datos biométricos — RGPD art. 9. Off por defecto.
  faceIdGuardarFoto           Boolean  @default(false) @map("face_id_guardar_foto")
  // Días de retención del snapshot biométrico. El cron de purga
  // (`/api/cron/purge-biometrics`) borra fotos con `timestamp` mayor
  // a este número de días. RGPD art. 5.1.e (minimización).
  retencionFotosDias          Int      @default(90) @map("retencion_fotos_dias")
  // Si true, al fichar ENTRADA/SALIDA el empleado debe confirmar los
  // puntos de control activos (`ChecklistFichajeItem`) antes de que se
  // registre el fichaje. Off por defecto: cada tenant lo activa.
  checklistFichajeActivo      Boolean  @default(false) @map("checklist_fichaje_activo")
  // Si true, no se puede fichar antes ni después del turno publicado en el
  // cuadrante (ticket 25c81b6b). El intento no se pierde: el empleado puede
  // pedir que se registre ajustado al horario de su turno y lo aprueba un
  // responsable (SolicitudFichaje clase "fuera_horario"). Off por defecto.
  exigirFichajeEnHorario      Boolean  @default(false) @map("exigir_fichaje_en_horario")
  // Minutos de cortesía antes del inicio y después del fin del turno en los
  // que sí se admite fichar directamente.
  margenFichajeMinutos        Int      @default(15) @map("margen_fichaje_minutos")
  notifAusencias              Boolean  @default(true)
  notifTurnos                 Boolean  @default(true)
  notifTareas                 Boolean  @default(true)
  notifFichajes               Boolean  @default(false)
  notifComunicados            Boolean  @default(true)
  notifDocumentos             Boolean  @default(true)
  // Aviso por email a OWNER + managers de la sede cuando un empleado
  // ficha a más distancia de la sede que el radio configurado en
  // `Tienda.radio` (200 m por defecto). Solo avisa: RD 8/2019 impide
  // rechazar el fichaje por ubicación.
  notifFueraSede              Boolean  @default(true)
  /// Aviso diario de cierres de turno sin terminar (módulo Enterprise).
  /// Se manda a la hora LOCAL del cliente: un cron horario recorre los
  /// tenants y avisa solo a los que les toca en ese momento. Así una tienda
  /// que cierra a medianoche o un cliente en Canarias no reciben el aviso a
  /// media tarde con media plantilla aún trabajando.
  avisoCierresActivo          Boolean  @default(true) @map("aviso_cierres_activo")
  /// Hora local (0-23) a la que se manda el aviso.
  avisoCierresHora            Int      @default(23) @map("aviso_cierres_hora")
  /// Zona IANA del cliente. Canarias = Atlantic/Canary.
  avisoCierresZona            String   @default("Europe/Madrid") @map("aviso_cierres_zona")
  /// Último día ya avisado ("YYYY-MM-DD" en su zona). Evita duplicar el correo
  /// si el cron se ejecuta dos veces dentro de la misma hora.
  avisoCierresUltimoDia       String?  @map("aviso_cierres_ultimo_dia")
  /// Interruptor de precios del catálogo de ventas. Encendido, el catálogo
  /// admite un precio por artículo y las ventas se pueden leer también en
  /// euros (importe vendido) para cruzarlas con la caja. Apagado, el módulo
  /// solo cuenta unidades. Off por defecto: cada cliente decide.
  ventasPreciosActivos        Boolean  @default(false) @map("ventas_precios_activos")
  /// El módulo de cierre de turno está EN RODAJE: solo lo ve administración.
  /// Sirve para prepararlo (subir el catálogo, repartir los PIN de recogida,
  /// fijar los objetivos del mes) antes de que le aparezca de golpe en el menú
  /// a toda la plantilla. Arranca en `true`: contratar el módulo no debe
  /// significar soltárselo al equipo sin avisar. Se abre desde
  /// Configuración → Catálogo de ventas con un clic.
  cierreTurnoEnRodaje         Boolean  @default(true) @map("cierre_turno_en_rodaje")
  /// A partir de qué diferencia (en euros) se considera descuadre en la
  /// conciliación. Por debajo es ruido de redondeo y llenar la pantalla de
  /// avisos de céntimos la vuelve inútil. Configurable porque no todos los
  /// negocios tienen la misma tolerancia.
  descuadreUmbral             Decimal  @default(1.00) @map("descuadre_umbral") @db.Decimal(10, 2)
  /// Cómo leer el Excel del banco de ESTE cliente: qué columna es la fecha,
  /// el importe, el concepto y la referencia, y en qué formato viene la fecha.
  /// Cada banco exporta distinto, así que el mapeo es del tenant y no del
  /// producto. Forma: ver `MapeoBanco` en `src/lib/cierre-turno/banco.ts`.
  bancoMapeo                  Json?    @map("banco_mapeo")
  /// Lo mismo para el export del sistema de facturación (ticket 4b8e1d05):
  /// cada operador exporta a su manera y el mapeo es del tenant.
  facturacionMapeo            Json?    @map("facturacion_mapeo")
  emailActivo                 Boolean  @default(false)
  emailHost                   String?
  emailPort                   Int?
  emailSecure                 Boolean  @default(true)
  emailUser                   String?
  emailPassword               String?
  emailFrom                   String?
  pushActivo                  Boolean  @default(false)
  pushVapidPublicKey          String?
  pushVapidPrivateKey         String?
  favicon                     String?
  colorPrimario               String   @default("#6366f1")
  colorSidebar                String   @default("#1e1b4b")
  appNombre                   String   @default("TelecomFichaje")
  // Fase 6 §3.1: configuración general por tenant.
  zonaHoraria                 String   @default("Europe/Madrid")
  diasLaborables              Int[]    @default([1, 2, 3, 4, 5])
  ausenciasDefaults           Json?
  // Reglas de cálculo de prenómina (feature `prenomina`, Enterprise-ready).
  nominaJornadaSemanal        Decimal  @default(40.00) @db.Decimal(5, 2)
  nominaHoraExtraFactor       Decimal  @default(1.75) @db.Decimal(4, 2)
  nominaPlusNocturnidadActivo Boolean  @default(false)
  nominaNocturnidadDesde      String   @default("22:00")
  nominaNocturnidadHasta      String   @default("06:00")
  nominaPlusNocturnidadFactor Decimal  @default(1.25) @db.Decimal(4, 2)
  nominaPlusFestivoActivo     Boolean  @default(false)
  nominaPlusFestivoFactor     Decimal  @default(1.75) @db.Decimal(4, 2)
  nominaSalarioBaseDefault    Decimal  @default(0.00) @db.Decimal(10, 2)
  nominaMoneda                String   @default("EUR")
  updatedAt                   DateTime @updatedAt
}

model PreferenciasNotificacion {
