model Documento {
  id                  String           @id @default(cuid())
  nombre              String
  descripcion         String?
  url                 String?
  tipo                String           @default("otro")
  userId              String?
  user                User?            @relation("DocumentoEmpleado", fields: [userId], references: [id])
  subidoPorId         String
  subidoPor           User             @relation("DocumentoSubido", fields: [subidoPorId], references: [id])
  createdAt           DateTime         @default(now())
  // Documentos creados a partir de una PlantillaDocumento (envío como alta o
  // adjuntar plantilla): `campos` es la definición congelada de los campos que
  // el empleado debe rellenar ([{ label, tipo }]); `camposRespuestas` son sus
  // respuestas alineadas por índice (string[]). Ambos null en documentos
  // normales que no vienen de plantilla.
  campos              Json?
  camposRespuestas    Json?
  // Copia del documento con las respuestas del empleado estampadas en las
  // posiciones marcadas en la plantilla (data URL de PDF). Se regenera cada vez
  // que el empleado guarda sus respuestas. Null si la plantilla no marcó
  // posiciones o el archivo no es estampable.
  documentoRellenoUrl String?          @map("documento_relleno_url")
  firmas              Firma[]
  solicitudesFirma    SolicitudFirma[] @relation("SolicitudFirmaDocumento")

  @@index([userId])
  @@index([subidoPorId])
}

// Plantilla de documento reutilizable (Plan RR.HH.): el OWNER/MANAGER sube un
// documento contractual una vez, marca los campos que el empleado tendrá que
// rellenar y luego lo envía a uno o varios empleados —como parte del alta o
// adjuntándolo desde el envío de documentos—. Cada envío materializa un
// `Documento` para el destinatario copiando nombre, archivo, carpeta y campos.
model PlantillaDocumento {
  id             String   @id @default(cuid())
  nombre         String
  descripcion    String?
  // Archivo base de la plantilla (data URL o https same-origin, validado con
  // isSafeDocUrl igual que Documento.url).
  url            String?
  // Carpeta destino (slug de TipoDocumento) donde caerá el documento enviado.
  tipo           String   @default("otro")
  // Campos que el empleado deberá rellenar: [{ label, tipo }].
  campos         Json     @default("[]")
  // Si true (o la carpeta es la de contratos), al enviar se crea una
  // SolicitudFirma para que el empleado firme el documento.
  solicitarFirma Boolean  @default(false)
  orden          Int      @default(0)
  createdById    String
  createdBy      User     @relation("PlantillaCreador", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdById])
}

// Firma electrónica de documentos. Plan D.2 + Sprint 1 #2.
//
// Flujo: el OWNER/MANAGER crea una SolicitudFirma sobre un documento
// para uno o varios empleados. Cada empleado recibe la solicitud en
// su bandeja de firmas (`/empleado/firmas`) y al firmar se crea un
// registro `Firma` con el hash del documento, IP y user agent (sello
// temporal con valor probatorio básico — ENISA "firma simple avanzada").
//
// Integración con proveedor real (DocuSign/Signaturit) diferida a Fase 9.

enum EstadoSolicitudFirma {
  pendiente
  firmada
  rechazada
  expirada
}

model SolicitudFirma {
  id              String               @id @default(cuid())
  documentoId     String
  documento       Documento            @relation("SolicitudFirmaDocumento", fields: [documentoId], references: [id], onDelete: Cascade)
  destinatarioId  String
  destinatario    User                 @relation("SolicitudFirmaDestinatario", fields: [destinatarioId], references: [id])
  solicitadaPorId String
  solicitadaPor   User                 @relation("SolicitudFirmaSolicitante", fields: [solicitadaPorId], references: [id])
  mensaje         String?
  estado          EstadoSolicitudFirma @default(pendiente)
  expiraEn        DateTime?            @map("expira_en")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  firma           Firma?               @relation("SolicitudFirma")

  @@index([destinatarioId])
  @@index([documentoId])
  @@index([estado])
}

model Firma {
  id                  String          @id @default(cuid())
  documentoId         String
  documento           Documento       @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  userId              String
  user                User            @relation("FirmaUsuario", fields: [userId], references: [id])
  // Vínculo opcional con la solicitud. Una firma "espontánea" del propio
  // usuario sobre su documento NO requiere solicitud previa.
  solicitudId         String?         @unique
  solicitud           SolicitudFirma? @relation("SolicitudFirma", fields: [solicitudId], references: [id])
  documentHash        String          @map("document_hash")
  ip                  String?
  userAgent           String?         @map("user_agent")
  firmadoEn           DateTime        @default(now()) @map("firmado_en")
  // Identidad manuscrita capturada al firmar (contratos laborales y anexos):
  // nombre y DNI/NIE tecleados por el firmante + garabato manuscrito (PNG
  // data URL). Se estampan en el margen izquierdo de cada hoja del documento.
  firmanteNombre      String?         @map("firmante_nombre")
  firmanteDni         String?         @map("firmante_dni")
  firmaImagen         String?         @map("firma_imagen")
  // Copia del documento con la firma estampada en cada página (PDF data URL).
  documentoFirmadoUrl String?         @map("documento_firmado_url")

  @@index([documentoId])
  @@index([userId])
}

model Festivo {
  id          String             @id @default(cuid())
  nombre      String
  fecha       DateTime
  // Ámbito: "nacional" (aplica a toda la plantilla) o "local" (solo a la
  // sede `tiendaId`). Los festivos locales requieren `tiendaId`.
  ambito      String             @default("nacional")
  // Sede a la que aplica un festivo local. null para festivos nacionales.
  // ON DELETE CASCADE: si se borra la sede, sus festivos locales se van con ella.
  tiendaId    String?
  tienda      Tienda?            @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  // Excepciones por empleado: la presencia de una fila significa que ese
  // empleado SÍ trabaja ese día (se le "quita" el festivo para asignar
  // jornada / horas extra). Ausencia de fila = el festivo le aplica.
  excepciones FestivoExcepcion[]
  createdAt   DateTime           @default(now())

  @@index([tiendaId])
}

// Excepción de un festivo para un empleado concreto: lo "quita" para que
// ese día sea laborable para esa persona (horas extra). Ver Festivo.excepciones.
model FestivoExcepcion {
  id        String   @id @default(cuid())
  festivoId String
  festivo   Festivo  @relation(fields: [festivoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([festivoId, userId])
  @@index([userId])
}

// Webhook outbound del tenant. Plan D.5.
model TenantWebhook {
  id          String    @id @default(cuid())
  url         String
  events      String[]
  secret      String
  active      Boolean   @default(true)
  lastFiredAt DateTime? @map("last_fired_at")
  failCount   Int       @default(0) @map("fail_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([active])
}

model ProcesoOnboarding {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  tipo        String            @default("ONBOARDING")
  estado      String            @default("PENDIENTE")
  fechaInicio DateTime
  fechaFin    DateTime?
  notas       String?
  tareas      TareaOnboarding[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
}

model TareaOnboarding {
  id          String            @id @default(cuid())
  procesoId   String
  proceso     ProcesoOnboarding @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  titulo      String
  descripcion String?
  completada  Boolean           @default(false)
  orden       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([procesoId])
}

model PlantillaTareaOnboarding {
  id          String   @id @default(cuid())
  tipo        String
  titulo      String
  descripcion String?
  orden       Int      @default(0)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BolsaHoras {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  tipo          String
  horas         Float
  concepto      String
  fecha         DateTime
  aprobadoPorId String?
  aprobadoPor   User?    @relation("BolsaHorasAprobador", fields: [aprobadoPorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ─── Canal de denuncias (Ley 2/2023) ───────────────────────────────────────────
//
// Buzón confidencial con plazos legales explícitos:
//   - Acuse de recibo en máx 7 días desde recepción.
//   - Resolución en máx 3 meses (prorrogable a 6 si se justifica).
//
// El informante puede ser anónimo. En ese caso se le devuelve un `accessToken`
// (256 bits) que sirve como única credencial para volver a consultar el
// estado y aportar nueva información sin revelar identidad.

enum CategoriaDenuncia {
  acoso_laboral
  acoso_sexual
  discriminacion
  fraude
  corrupcion
  incumplimiento_normativo
  proteccion_datos
  seguridad_salud
  otro
}

enum EstadoDenuncia {
  recibida
  acuse_recibido
  en_investigacion
  resuelta
  archivada
}

model Denuncia {
  id                 String               @id @default(cuid())
  // Anonimato y acceso
  esAnonima          Boolean              @default(false)
  // Token para que un informante anónimo consulte/responda sin login.
  // Hash del token real — el token plain solo se devuelve UNA VEZ al crear.
  accessTokenHash    String?              @unique
  // Datos de contacto del informante (null si anónima)
  informanteEmail    String?
  informanteNombre   String?
  informanteTelefono String?
  // Si el denunciante es un usuario logueado (no anónimo), referencia.
  informanteUserId   String?
  informanteUser     User?                @relation("DenunciaInformante", fields: [informanteUserId], references: [id])
  // Datos de la denuncia
  asunto             String
  categoria          CategoriaDenuncia
  descripcion        String
  fechaIncidente     DateTime?
  // Estado y trazabilidad
  estado             EstadoDenuncia       @default(recibida)
  asignadoUserId     String?
  asignadoUser       User?                @relation("DenunciaAsignada", fields: [asignadoUserId], references: [id])
  // Plazos legales (Ley 2/2023)
  acuseReciboAt      DateTime?            @map("acuse_recibo_at")
  resolucionAt       DateTime?            @map("resolucion_at")
  resolucionResumen  String?              @map("resolucion_resumen")
  // Auditoría
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  // Relaciones
  comentarios        ComentarioDenuncia[]

  @@index([estado])
  @@index([categoria])
  @@index([createdAt])
  @@index([asignadoUserId])
}

model ComentarioDenuncia {
  id          String   @id @default(cuid())
  denunciaId  String
  denuncia    Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  // Quien escribe: usuario logueado o el informante anónimo (null + autorRole)
  autorUserId String?
  autorUser   User?    @relation("ComentarioDenunciaAutor", fields: [autorUserId], references: [id])
  // "informante" si lo escribe el denunciante anónimo via token,
  // "instructor" / "comite" / "owner" si lo escribe alguien del staff.
  autorRole   String
  contenido   String
  // Visibilidad: si es interno (notas del comité que el informante no ve)
  esInterno   Boolean  @default(false) @map("es_interno")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([denunciaId])
}

// ─── Reclutamiento (ATS) ───────────────────────────────────────────────────────
// Sprint 1 #3. Pipeline básico de selección: ofertas + candidatos.
// Cada candidato avanza por estados kanban (recibido → preselec → entrevista
// → oferta → contratado / rechazado). Los CV se almacenan como URL externa
// para evitar la complejidad de blob storage en este MVP.

enum EstadoOferta {
  borrador
  abierta
  pausada
  cerrada
}

enum EstadoCandidato {
  recibido
  preseleccionado
  entrevista
  oferta_enviada
  contratado
  rechazado
}

model OfertaTrabajo {
  id              String       @id @default(cuid())
  titulo          String
  descripcion     String
  departamento    String?
  ubicacion       String?
  modalidad       String? // presencial / remoto / híbrido
  salarioMinCents Int?         @map("salario_min_cents")
  salarioMaxCents Int?         @map("salario_max_cents")
  estado          EstadoOferta @default(borrador)
  fechaCierre     DateTime?    @map("fecha_cierre")
  creadorId       String
  creador         User         @relation("OfertaCreador", fields: [creadorId], references: [id])
  candidatos      Candidato[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([estado])
  @@index([creadorId])
}

// ─── Asistente IA (Sprint 2 #1) ────────────────────────────────────────────────
//
// Modelo BYOK (Bring Your Own Key): cada tenant configura su propio
// proveedor de LLM (Anthropic / OpenAI / Google). La API key se guarda
// cifrada con AES-256-GCM (clave maestra en IA_ENCRYPTION_KEY env).
// El coste de tokens lo paga el tenant directamente al proveedor.

enum ProveedorIA {
  anthropic
  openai
  google
}

model IAConfiguracion {
  // Singleton por tenant. id fijo a "default" para garantizar 1 fila.
  id             String      @id @default("default")
  provider       ProveedorIA
  apiKeyEnc      Bytes       @map("api_key_enc")
  modelo         String // ej. "claude-sonnet-4-6", "gpt-4o", "gemini-1.5-pro"
  endpointUrl    String?     @map("endpoint_url") // opcional para Azure/self-hosted
  systemPrompt   String?     @map("system_prompt") // override del system prompt
  activa         Boolean     @default(true)
  ultimaPruebaAt DateTime?   @map("ultima_prueba_at")
  ultimaPruebaOk Boolean?    @map("ultima_prueba_ok")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
}

model ConversacionIA {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation("ConversacionIAUser", fields: [userId], references: [id])
  titulo    String
  mensajes  MensajeIA[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([updatedAt])
}

model MensajeIA {
  id             String         @id @default(cuid())
  conversacionId String
  conversacion   ConversacionIA @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  rol            String // "user" | "assistant" | "system"
  contenido      String
  tokensInput    Int?           @map("tokens_input")
  tokensOutput   Int?           @map("tokens_output")
  modelo         String?
  errorMsg       String?        @map("error_msg")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversacionId])
}

// ─── Face ID — fichaje con reconocimiento facial (Sprint 2 #2) ─────────────────
//
// El embedding facial (vector 128 floats normalizado) se almacena cifrado
// con AES-256-GCM (misma clave maestra que IA). Es irreversible: con el
// embedding solo se puede comparar (cosine similarity) contra otro
// embedding nuevo, no reconstruir la imagen original.

/// Chat interno. Feature: `chat`. MVP basado en polling (sin realtime).
///
/// `Conversacion` representa una conversación 1:1 (`tipo="directo"`)
/// o grupal (`tipo="grupo"`). Participantes en `ParticipanteConversacion`.
/// Mensajes ordenados por createdAt.
model Conversacion {
  id            String                     @id @default(cuid())
  nombre        String?
  tipo          String                     @default("directo") // directo | grupo
  creadoPorId   String?
  participantes ParticipanteConversacion[]
  mensajes      Mensaje[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
}

model ParticipanteConversacion {
  id             String       @id @default(cuid())
  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ultimoLeidoAt  DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversacionId, userId])
  @@index([userId])
}

model Mensaje {
  id             String       @id @default(cuid())
  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autorId        String
  autor          User         @relation("MensajeAutor", fields: [autorId], references: [id])
  texto          String
  createdAt      DateTime     @default(now())

  @@index([conversacionId, createdAt])
}

/// Configuración WhatsApp Business (singleton). Feature: `whatsapp_bot`.
///
/// MVP: solo almacena las credenciales y registra mensajes a enviar en
/// `MensajeWhatsapp`. Sin envío real — un worker externo recogerá la
/// cola cuando se implemente la integración con WhatsApp Cloud API.
/// El token va cifrado con `IA_ENCRYPTION_KEY`.
model WhatsappConfig {
  id            String   @id @default("singleton")
  phoneNumberId String?
  /// Token cifrado AES-GCM (mismo schema que IAConfiguracion.apiKeyEnc).
  tokenEnc      Bytes?
  numeroEmpresa String?
  activo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MensajeWhatsapp {
  id                   String    @id @default(cuid())
  destinatarioTelefono String
  texto                String
  estado               String    @default("pendiente") // pendiente | enviado | fallido
  motivoError          String?
  enviadoAt            DateTime?
  createdAt            DateTime  @default(now())

  @@index([estado])
  @@index([createdAt])
}

/// Catálogo de integraciones del marketplace. Feature: `marketplace`.
///
/// Las integraciones son metadatos estáticos seedeados; cada tenant
/// activa las que quiera con su configuración propia. No hay ejecución
/// real — solo registro de que el tenant ha "conectado" la integración.
model Integracion {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  nombre        String
  descripcion   String
  categoria     String // "comunicacion" | "nominas" | "calendario" | etc.
  logoUrl       String?
  esquemaConfig Json? // JSON Schema de los campos config
  instalaciones IntegracionInstalada[]
  createdAt     DateTime               @default(now())
}

model IntegracionInstalada {
  id            String      @id @default(cuid())
  integracionId String
  integracion   Integracion @relation(fields: [integracionId], references: [id], onDelete: Cascade)
  configuracion Json
  activa        Boolean     @default(true)
  activadaPorId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integracionId])
}

/// Empresa dentro del tenant. Feature: `multi_empresa`. MVP: etiquetado.
///
/// Permite agrupar empleados/sedes bajo varios CIFs del mismo grupo
/// empresarial. Los datos siguen viviendo en el mismo schema tenant,
/// el `empresaId` es solo un campo de agrupación + filtrado en informes.
model Empresa {
  id           String   @id @default(cuid())
  nombre       String
  cif          String   @unique
  direccion    String?
  codigoPostal String?
  ciudad       String?
  pais         String?  @default("España")
  telefono     String?
  email        String?
  activa       Boolean  @default(true)
  usuarios     User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Declaración mensual de retribución flexible. Feature: `retribucion_flex`.
///
/// El empleado declara importes en cada concepto (tickets restaurante,
/// guardería, transporte, seguro médico). El sistema calcula el ahorro
/// fiscal estimado con tablas internas. Sin emisión real de tickets —
/// la integración con proveedores (Cobee, Pluxee, Edenred) queda fuera.
model DeclaracionFlex {
  id         String   @id @default(cuid())
  empleadoId String
  empleado   User     @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  periodo    String // "2026-05"
  concepto   String // tickets_restaurante | guarderia | transporte | seguro_medico
  importe    Decimal  @db.Decimal(10, 2)
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([empleadoId, periodo, concepto], name: "empleado_periodo_concepto_uniq")
  @@index([empleadoId, periodo])
}

/// Evaluación de desempeño 1:1 (evaluador → evaluado) en un ciclo.
/// Feature: `evaluaciones`. Pro+Enterprise.
model Evaluacion {
  id           String    @id @default(cuid())
  ciclo        String // "2026-H1", "2026-Q1", etc.
  evaluadoAId  String
  evaluadoA    User      @relation("EvaluacionEvaluado", fields: [evaluadoAId], references: [id])
  evaluadorId  String
  evaluador    User      @relation("EvaluacionEvaluador", fields: [evaluadorId], references: [id])
  /// [{ idx, texto, tipo: "escala_1_5" | "texto" }]
  preguntas    Json
  /// [{ preguntaIdx, valor: number | string }] | null antes de completar
  respuestas   Json?
  comentarios  String?
  estado       String    @default("pendiente") // pendiente | completada
  createdAt    DateTime  @default(now())
  completadaAt DateTime?

  @@index([evaluadoAId])
  @@index([evaluadorId])
  @@index([ciclo])
}

/// Gasto que el empleado registra para reembolso. Feature: `control_gastos`.
model Gasto {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  concepto           String
  importe            Decimal   @db.Decimal(10, 2)
  moneda             String    @default("EUR")
  categoria          String    @default("varios") // dietas | transporte | hotel | material | varios
  fecha              DateTime
  ticketUrl          String? // URL/data del ticket subido (data URL pequeño OK)
  notas              String?
  estado             String    @default("pendiente") // pendiente | aprobado | rechazado
  revisorId          String?
  revisor            User?     @relation("GastoRevisor", fields: [revisorId], references: [id])
  revisadoAt         DateTime?
  comentarioRevision String?
  createdAt          DateTime  @default(now())

  @@index([userId])
  @@index([estado])
  @@index([fecha])
}

/// Espacio reservable. Feature: `reserva_espacios`.
model EspacioReservable {
  id          String           @id @default(cuid())
  nombre      String
  descripcion String?
  capacidad   Int              @default(1)
  ubicacion   String?
  activo      Boolean          @default(true)
  reservas    ReservaEspacio[]
  createdAt   DateTime         @default(now())
}

model ReservaEspacio {
  id        String            @id @default(cuid())
  espacioId String
  espacio   EspacioReservable @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  inicio    DateTime
  fin       DateTime
  motivo    String?
  createdAt DateTime          @default(now())

  @@index([espacioId, inicio])
  @@index([userId])
}

/// Archivo de nómina enviado a un empleado. Feature: `envio_nominas`.
model NominaArchivo {
  id            String    @id @default(cuid())
  empleadoId    String
  empleado      User      @relation("NominaArchivoEmpleado", fields: [empleadoId], references: [id])
  /// "2026-04", "2026-05", etc. (mes de la nómina)
  periodo       String
  /// Data URL del PDF o URL externa. En MVP guardamos data URL.
  pdfUrl        String
  nombreArchivo String
  tamañoBytes  Int       @default(0)
  subidoPorId   String
  subidoPor     User      @relation("NominaArchivoSubidoPor", fields: [subidoPorId], references: [id])
  /// Marca de visualización por el empleado.
  vistoAt       DateTime?
  createdAt     DateTime  @default(now())

  @@unique([empleadoId, periodo], name: "empleado_periodo_uniq")
  @@index([empleadoId])
}

/// Curso de formación. Feature: `formacion`.
model Curso {
  id           String            @id @default(cuid())
  titulo       String
  descripcion  String?
  /// URL externa al contenido (vídeo, PDF, web). Sin player propio en MVP.
  contenidoUrl String?
  duracionMin  Int               @default(60)
  creadoPorId  String
  creadoPor    User              @relation("CursoCreador", fields: [creadoPorId], references: [id])
  asignaciones AsignacionCurso[]
  createdAt    DateTime          @default(now())
}

model AsignacionCurso {
  id           String    @id @default(cuid())
  cursoId      String
  curso        Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  empleadoId   String
  empleado     User      @relation("AsignacionCursoEmpleado", fields: [empleadoId], references: [id])
  fechaLimite  DateTime?
  completado   Boolean   @default(false)
  completadoAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([cursoId, empleadoId], name: "curso_empleado_uniq")
  @@index([empleadoId])
}

/// Petición personalizada del empleado (carta, certificado, anticipo, etc.).
/// Feature: `custom_requests`.
model Peticion {
  id            String    @id @default(cuid())
  solicitanteId String
  solicitante   User      @relation("PeticionSolicitante", fields: [solicitanteId], references: [id])
  tipo          String // "certificado_empresa" | "anticipo" | "cambio_datos" | "otro"
  titulo        String
  descripcion   String
  estado        String    @default("pendiente") // pendiente | en_proceso | resuelta | rechazada
  respuesta     String?
  gestorId      String?
  gestor        User?     @relation("PeticionGestor", fields: [gestorId], references: [id])
  resueltaAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([solicitanteId])
  @@index([estado])
}

/// Encuesta de clima laboral. Feature: `encuestas_clima`. Pro+Enterprise.
///
/// Preguntas y respuestas se guardan como JSONB para evitar el costo
/// relacional de un esquema multitabla (Pregunta + Opcion + Respuesta
/// + Item) — para el caso de uso "encuesta pulse" con N preguntas
/// por encuesta, JSONB es mucho más simple sin perder consultabilidad.
///
/// Pregunta shape:
///   { idx: number, texto: string, tipo: "escala_1_5" | "texto" | "opcion", opciones?: string[] }
///
/// Si `anonima=true`, `RespuestaEncuesta.userId` se almacena como null;
/// el cliente no debe enviarlo y el backend lo fuerza a null. Sin esta
/// garantía, "encuesta anónima" sería una mentira.
model Encuesta {
  id          String              @id @default(cuid())
  titulo      String
  descripcion String?
  /// Array JSON de preguntas (orden según `idx`).
  preguntas   Json
  /// Si `true`, las respuestas no llevan `userId`. Inmutable tras crear.
  anonima     Boolean             @default(true)
  /// "borrador" | "abierta" | "cerrada".
  estado      String              @default("abierta")
  /// Fecha tope para responder. Tras esa fecha la encuesta queda cerrada.
  cierraAt    DateTime?
  creadoPorId String
  creadoPor   User                @relation("EncuestaCreador", fields: [creadoPorId], references: [id])
  respuestas  RespuestaEncuesta[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([estado])
}

model RespuestaEncuesta {
  id         String   @id @default(cuid())
  encuestaId String
  encuesta   Encuesta @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
  /// Null si la encuesta es anónima. Si la encuesta es nominal, FK al usuario.
  userId     String?
  user       User?    @relation("RespuestaEncuestaUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Array JSON: [{ preguntaIdx: number, valor: number | string }].
  respuestas Json
  createdAt  DateTime @default(now())

  @@unique([encuestaId, userId], name: "encuesta_user_uniq")
  @@index([encuestaId])
}

/// Objetivos / OKRs. Feature: `objetivos`. Pro+Enterprise.
///
/// Modelo simple: cada objetivo tiene un % de progreso (0-100) que se
/// actualiza manualmente. Key Results detallados (con valor actual /
/// objetivo / unidad) son una iteración futura.
///
/// Si `asignadoAId` es null, el objetivo es de empresa (afecta a toda
/// la organización). Si tiene valor, es individual del usuario.
model Objetivo {
  id          String    @id @default(cuid())
  titulo      String
  descripcion String?
  asignadoAId String?
  asignadoA   User?     @relation("ObjetivoAsignado", fields: [asignadoAId], references: [id])
  /// Free text: "2026-Q1", "2026", "Mayo 2026", etc.
  periodo     String
  /// Free text con set conocido: "activo" | "completado" | "cancelado".
  estado      String    @default("activo")
  /// 0-100. Avance manual del objetivo.
  progreso    Int       @default(0)
  creadoPorId String
  creadoPor   User      @relation("ObjetivoCreado", fields: [creadoPorId], references: [id])
  fechaCierre DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([asignadoAId])
  @@index([estado])
  @@index([periodo])
}

model FaceTemplate {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation("FaceTemplateUser", fields: [userId], references: [id], onDelete: Cascade)
  embeddingEnc     Bytes    @map("embedding_enc")
  algoritmo        String   @default("face-api.js@0.22") // versión + librería
  // Consentimiento GDPR — registro inmutable del momento de la enrolación.
  consentimientoAt DateTime @default(now()) @map("consentimiento_at")
  consentimientoIp String?  @map("consentimiento_ip")
  consentimientoUa String?  @map("consentimiento_ua")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  verificaciones FaceVerificacion[]
}

model FaceVerificacion {
  id         String       @id @default(cuid())
  templateId String
  template   FaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Score de similitud cosine (0..1, más cerca de 1 = más parecido)
  score      Float
  // Resultado: match (>=umbral), no_match (<umbral), spoof (anti-spoof falló)
  resultado  String
  ip         String?
  userAgent  String?      @map("user_agent")
  // Si la verificación se asoció a un fichaje real (link débil — no FK
  // para no romper si el fichaje se borra/anonimiza).
  fichajeId  String?      @map("fichaje_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([templateId])
  @@index([createdAt])
}

model Candidato {
  id          String          @id @default(cuid())
  ofertaId    String
  oferta      OfertaTrabajo   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  nombre      String
  apellidos   String
  email       String
  telefono    String?
  cvUrl       String?         @map("cv_url")
  linkedinUrl String?         @map("linkedin_url")
  notas       String?
  estado      EstadoCandidato @default(recibido)
  // Quien lo creó (admin que añadió al candidato manualmente,
  // o null si llegó vía portal público de la oferta).
  creadorId   String?
  creador     User?           @relation("CandidatoCreador", fields: [creadorId], references: [id])
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([ofertaId])
  @@index([estado])
  @@index([email])
}

/// Prenómina persistida: snapshot mensual por empleado con cifras
/// calculadas (horas/extras/ausencias/importes), conceptos manuales
/// editables y workflow de cierre (BORRADOR → CERRADA → ENVIADA).
/// Feature: `prenomina` (Pro+Enterprise).
model Prenomina {
  id                   String              @id @default(cuid())
  periodo              String // "YYYY-MM"
  empleadoId           String
  empleado             User                @relation("PrenominaEmpleado", fields: [empleadoId], references: [id], onDelete: Cascade)
  estado               EstadoPrenomina     @default(BORRADOR)
  horasTrabajadas      Decimal             @default(0) @db.Decimal(7, 2)
  horasOrdinarias      Decimal             @default(0) @db.Decimal(7, 2)
  horasExtras          Decimal             @default(0) @db.Decimal(7, 2)
  horasNocturnas       Decimal             @default(0) @db.Decimal(7, 2)
  horasFestivas        Decimal             @default(0) @db.Decimal(7, 2)
  diasTrabajados       Int                 @default(0)
  diasAusenciaPagada   Int                 @default(0)
  diasAusenciaNoPagada Int                 @default(0)
  salarioBase          Decimal             @default(0) @db.Decimal(10, 2)
  importeHorasExtras   Decimal             @default(0) @db.Decimal(10, 2)
  importeNocturnidad   Decimal             @default(0) @db.Decimal(10, 2)
  importeFestivos      Decimal             @default(0) @db.Decimal(10, 2)
  importeConceptos     Decimal             @default(0) @db.Decimal(10, 2)
  totalBruto           Decimal             @default(0) @db.Decimal(10, 2)
  moneda               String              @default("EUR")
  comentario           String?
  calculadaAt          DateTime?
  cerradaAt            DateTime?
  cerradaPorId         String?
  cerradaPor           User?               @relation("PrenominaCerrador", fields: [cerradaPorId], references: [id], onDelete: SetNull)
  enviadaAt            DateTime?
  enviadaPorId         String?
  enviadaPor           User?               @relation("PrenominaEnviador", fields: [enviadaPorId], references: [id], onDelete: SetNull)
  enviadaCanal         String? // "email", "manual", "sage", "a3"
  enviadaDestinatario  String? // email del gestor laboral
  conceptos            PrenominaConcepto[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([periodo, empleadoId])
  @@index([periodo])
  @@index([empleadoId])
  @@index([estado])
}

/// Concepto manual añadido a una Prenomina (dieta, kilometraje,
/// comisión, plus, bonus, deducción o "otro"). Se suma a
/// `Prenomina.importeConceptos` al guardar.
model PrenominaConcepto {
  id          String                @id @default(cuid())
  prenominaId String
  prenomina   Prenomina             @relation(fields: [prenominaId], references: [id], onDelete: Cascade)
  tipo        TipoConceptoPrenomina
  descripcion String
  cantidad    Decimal?              @db.Decimal(8, 2)
  importe     Decimal               @db.Decimal(10, 2)
  notas       String?
  createdAt   DateTime              @default(now())

  @@index([prenominaId])
}

// ─── Campos personalizados de la ficha del empleado ──────────────────
// El OWNER define campos extra ("Talla de uniforme", "Nº de taquilla"…)
// desde la ficha de cualquier empleado. La definición es del tenant y
// aplica a TODOS los empleados; el valor se guarda por empleado.
model CampoPersonalizado {
  id        String               @id @default(cuid())
  // Clave estable (slug) generada desde la etiqueta. Única por tenant.
  clave     String               @unique
  etiqueta  String
  // Tipo de dato para el render del input: "texto" | "numero" | "fecha".
  tipo      String               @default("texto")
  orden     Int                  @default(0)
  activo    Boolean              @default(true)
  valores   ValorCampoEmpleado[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([activo])
}

// Valor de un campo personalizado para un empleado concreto.
model ValorCampoEmpleado {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campoId   String
  campo     CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)
  valor     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, campoId])
  @@index([campoId])
}

// ─── Cierre de turno (plan Enterprise, feature `cierre_turno`) ─────────────────
//
// Control diario de ventas y caja. Cinco áreas apoyadas en estos modelos:
// Cierre de turno (asistente diario), Objetivos, Arqueos, Conciliación e
// informes de ventas. Nada de esto altera fichajes, turnos ni ausencias.
//
// Regla que atraviesa el módulo: NADA aquí puede impedir fichar. El registro
// de jornada es una obligación legal (RD 8/2019) y no depende de que el
// comercial haya cerrado su caja — lo que falte se reclama después.

/// Catálogo de lo que se vende, editable por el OWNER e importable desde
/// Excel. La tabla de ventas del cierre diario se pinta a partir de aquí.
/// Los artículos no se borran (`activo = false`) para que el histórico de
/// ventas siga siendo legible.
model ArticuloVenta {
  id        String  @id @default(cuid())
  nombre    String
  /// Agrupa filas en la tabla del cierre ("Telefonía", "Servicios"…) y sale en
  /// los informes. NO es un nivel con objetivo propio (ticket 234c6b0f): solo
  /// acompaña a `subcategoria` para saber de qué grupo se habla.
  categoria String?
  /// Segundo nivel dentro de la categoría ("Pospago" dentro de "Telefonía").
  /// Ordena y agrupa el catálogo —en Configuración y en la tabla del cierre— y
  /// es el grupo sobre el que se fijan objetivos (`ObjetivoVenta.subcategoria`):
  /// el comercial registra producto a producto y las unidades de los productos
  /// de la subcategoría se suman para compararlas con el objetivo.
  subcategoria String?
  orden     Int     @default(0)
  activo    Boolean @default(true)
  /// Precio de venta unitario. Solo se usa si el cliente enciende los precios
  /// (`ConfiguracionEmpresa.ventasPreciosActivos`): hay clientes que solo
  /// cuentan unidades y pedirles precios sería inventarse un dato.
  precio    Decimal? @db.Decimal(10, 2)
  /// Sus unidades empujan los objetivos de unidades totales y los de su grupo.
  /// Apagado, el artículo se sigue vendiendo y registrando en el cierre pero no
  /// cuenta para ningún objetivo: en casi todos los catálogos hay conceptos que
  /// no se persiguen (accesorios, altas de cortesía) y sumarlos infla la
  /// consecución de quien tiene el objetivo puesto sobre otra cosa.
  cuentaParaObjetivos Boolean @default(true)

  ventas    CierreTurnoVenta[]
  objetivos ObjetivoVenta[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([activo, orden])
}

/// Un cierre por comercial y día. Nace como borrador al empezar el asistente
/// y pasa a `completado` cuando confirma el último paso.
model CierreTurno {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation("CierreTurnoEmpleado", fields: [userId], references: [id], onDelete: Cascade)
  /// Sede en la que hizo el turno (la suya en el momento del cierre).
  tiendaId String?
  tienda   Tienda?  @relation(fields: [tiendaId], references: [id])
  /// Día del turno, a medianoche (un cierre por persona y día).
  fecha    DateTime @db.Date

  /// "borrador" | "completado" | "revisado"
  estado         String    @default("borrador")
  /// El cuadro de texto del paso 1: qué ha hecho durante la jornada.
  detalleJornada String?
  /// Texto de la incidencia del paso 4. null = no hubo incidencia.
  incidencia     String?
  /// Cuándo confirmó el paso 4 (null mientras sea borrador).
  completadoEn   DateTime?

  ventas    CierreTurnoVenta[]
  caja      CierreCaja?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, fecha])
  @@index([tiendaId, fecha])
  @@index([estado])
}

/// Cantidad vendida de un artículo en un cierre. `nombreArticulo` es una
/// copia del enunciado en el momento del cierre: si luego se renombra el
/// artículo, el histórico sigue contando lo que se vendió entonces.
model CierreTurnoVenta {
  id             String         @id @default(cuid())
  cierreId       String
  cierre         CierreTurno    @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  articuloId     String?
  articulo       ArticuloVenta? @relation(fields: [articuloId], references: [id], onDelete: SetNull)
  nombreArticulo String
  cantidad       Int            @default(0)

  @@unique([cierreId, articuloId])
  @@index([articuloId])
}

/// Cierre de caja del paso 3. Uno por cierre de turno.
///
/// `tiendaId` y `fecha` se duplican aquí a propósito: permiten cuadrar por
/// tienda y día sin pasar por el cierre, y dejan la puerta abierta a una
/// caja compartida por tienda y turno (pendiente de decidir) sin rehacer
/// las consultas de conciliación.
model CierreCaja {
  id       String      @id @default(cuid())
  cierreId String      @unique
  cierre   CierreTurno @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  tiendaId String?
  fecha    DateTime    @db.Date

  efectivo Decimal @default(0) @db.Decimal(10, 2)
  tarjeta  Decimal @default(0) @db.Decimal(10, 2)

  /// A partir de aquí el comercial NO puede modificarlo: solo un
  /// administrador, y cada cambio queda en CierreCajaEdicion.
  confirmadoEn DateTime?

  adjuntos  CierreCajaAdjunto[]
  ediciones CierreCajaEdicion[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([tiendaId, fecha])
}

/// Excel del stock y comprobantes del TPV que acompañan al cierre de caja.
model CierreCajaAdjunto {
  id           String     @id @default(cuid())
  cajaId       String
  caja         CierreCaja @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  /// "stock" (Excel de la tienda) | "tpv" (comprobante del datáfono)
  tipo         String
  nombre       String
  mime         String
  tamañoBytes Int        @default(0)
  /// Contenido del fichero. Igual que en Documentos: se guarda en BD para
  /// no depender de un almacén externo por tenant.
  contenido    Bytes
  createdAt    DateTime   @default(now())

  @@index([cajaId, tipo])
}

/// Rastro de cada edición de un administrador sobre un cierre de caja ya
/// confirmado. Sin esto, "solo lo pueden modificar los administradores" no
/// sirve de nada el día que se discuta un descuadre.
model CierreCajaEdicion {
  id           String     @id @default(cuid())
  cajaId       String
  caja         CierreCaja @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  adminId      String
  admin        User       @relation("CierreCajaEditor", fields: [adminId], references: [id])
  /// "efectivo" | "tarjeta"
  campo        String
  valorAntes   Decimal    @db.Decimal(10, 2)
  valorDespues Decimal    @db.Decimal(10, 2)
  /// Obligatorio: por qué se corrige.
  motivo       String
  createdAt    DateTime   @default(now())

  @@index([cajaId])
  @@index([adminId])
}

/// Objetivo de venta de un mes. Es de un comercial O de una sede (uno de los
/// dos, nunca ambos). `articuloId` vacío = objetivo total de unidades.
///
/// Distinto del modelo `Objetivo` (OKR con progreso manual), que se queda
/// para lo que ya hacía: aquí hace falta un número comparable con las ventas.
model ObjetivoVenta {
  id         String         @id @default(cuid())
  /// Mes en formato "YYYY-MM".
  mes        String
  userId     String?
  user       User?          @relation("ObjetivoVentaComercial", fields: [userId], references: [id], onDelete: Cascade)
  tiendaId   String?
  tienda     Tienda?        @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  /// Objetivo de un grupo de objetivos (TMT, equipo de televenta…). Es el
  /// tercer destinatario posible, excluyente con `userId` y `tiendaId`.
  grupoId    String?        @map("grupo_id")
  grupo      GrupoObjetivo? @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  articuloId String?
  articulo   ArticuloVenta? @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  /// Objetivo de un grupo de productos: la **subcategoría** del catálogo
  /// (`ArticuloVenta.subcategoria`). Excluyente con `articuloId`: un objetivo
  /// es de un producto, de una subcategoría o de unidades totales (los dos a
  /// null).
  ///
  /// El comercial sigue registrando sus ventas producto a producto; la cifra
  /// que se compara con el objetivo es la suma de TODOS los productos de esa
  /// subcategoría, cuelguen de la categoría que cuelguen (tickets 234c6b0f y
  /// 528694fa).
  subcategoria String?
  /// **Sin uso desde el ticket 528694fa.** La categoría (Particular, Empresa)
  /// organiza el catálogo, filtra informes y la elige el comercial al registrar
  /// la venta, pero NO es un nivel con objetivo: el objetivo de "FFTH" lo
  /// empujan los productos de FFTH de todas las categorías. Se dejó de escribir
  /// (siempre null) y el código la ignora al leer; la columna se conserva
  /// porque vaciarla es reversible y borrarla no.
  categoria  String?
  /// De quién es la cifra: la que pone la empresa (`propio`) o la que impone el
  /// operador (`tmt`). Son dos objetivos distintos sobre el MISMO punto de venta
  /// y las mismas ventas —el operador aprieta con su propia vara—, así que la
  /// fuente forma parte de lo que identifica un objetivo (ticket 5d8b21c7).
  fuente     FuenteObjetivo @default(propio)
  cantidad   Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mes, userId, tiendaId, grupoId, articuloId, categoria, subcategoria, fuente], map: "ObjetivoVenta_mes_destinatario_producto_key")
  @@index([mes])
}

/// Quién impone el objetivo. `tmt` es el que manda el operador para cada punto
/// de venta; `propio`, el que fija la empresa. Se comparan con las mismas
/// ventas y se enseñan en tablas separadas.
enum FuenteObjetivo {
  propio
  tmt
}

/// Grupo de objetivos: un conjunto de comerciales y/o puntos de venta al que
/// se le fija un objetivo propio ("TMT", "Televenta", una zona…).
///
/// Es el tercer ámbito de los objetivos de venta, junto al comercial y a la
/// sede. Existe porque el cliente persigue cifras que no son ni de una persona
/// ni de una tienda sueltas, y las agrupaciones las nombra él: aquí no se
/// cablea ninguna ("TMT" es una fila de esta tabla, no un valor del código).
///
/// Lo vendido del grupo es lo que han vendido sus miembros, contando cada venta
/// una sola vez aunque encaje por la persona y por la sede a la vez. Es
/// independiente de los objetivos de sus miembros: como pasa con las sedes, es
/// otra forma de apretar y no la suma de las otras.
model GrupoObjetivo {
  id        String                 @id @default(cuid())
  nombre    String                 @unique
  /// Un grupo no se borra si tiene objetivos: se desactiva y deja de pintarse.
  activo    Boolean                @default(true)
  orden     Int                    @default(0)
  miembros  GrupoObjetivoMiembro[]
  objetivos ObjetivoVenta[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([activo, orden])
}

/// Miembro de un grupo de objetivos: un comercial o un punto de venta
/// (exactamente uno de los dos, como en `ObjetivoVenta`).
model GrupoObjetivoMiembro {
  id        String        @id @default(cuid())
  grupoId   String        @map("grupo_id")
  grupo     GrupoObjetivo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  userId    String?       @map("user_id")
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiendaId  String?       @map("tienda_id")
  tienda    Tienda?       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([grupoId, userId])
  @@unique([grupoId, tiendaId])
  @@index([grupoId])
}

/// Arqueo semanal: el efectivo que la tienda aparta para que lo recoja un
/// superior. `efectivoCierres` guarda lo que sumaban los cierres diarios en
/// el momento de declararlo, para que la diferencia quede congelada.
/// Fondo de caja de una sede a una fecha (ticket 7ab2c5d9).
///
/// Es el efectivo que se queda en el cajón como punto de partida del día
/// siguiente: lo que el comercial cuenta al abrir para saber si le cuadra. No es
/// lo mismo que el efectivo de un cierre (lo que se recaudó ese turno) ni que el
/// arqueo semanal (lo que se aparta para que lo recojan).
///
/// Con histórico por fecha y no un campo en la sede: el cliente arranca cargando
/// el fondo de un día y después la situación de caja del año, y con un solo
/// número se perdería de dónde viene cada saldo.
///
/// `importe` puede ser NEGATIVO a propósito: si falta dinero, el dato tiene que
/// poder contarlo. Y `incidencia` es para las sedes cuya caja no se puede dar
/// por buena todavía: no hay importe que valga hasta que se aclare.
model FondoCaja {
  id         String   @id @default(cuid())
  tiendaId   String   @map("tienda_id")
  tienda     Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  /// Día al que corresponde el saldo, a medianoche.
  fecha      DateTime @db.Date
  /// Efectivo en el cajón. null cuando hay incidencia y no hay cifra fiable.
  importe    Decimal? @db.Decimal(10, 2)
  /// Por qué no hay importe ("pendiente de aclarar el descuadre del sábado").
  incidencia String?
  nota       String?
  registradoPorId String? @map("registrado_por_id")
  registradoPor   User?   @relation("FondoCajaRegistradoPor", fields: [registradoPorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tiendaId, fecha])
  @@index([fecha])
}

model Arqueo {
  id       String   @id @default(cuid())
  tiendaId String
  tienda   Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  /// Semana ISO en formato "YYYY-Www" (2026-W31).
  semana   String
  /// Primer y último día del periodo arqueado.
  desde    DateTime @db.Date
  hasta    DateTime @db.Date

  efectivoDeclarado Decimal @default(0) @db.Decimal(10, 2)
  efectivoCierres   Decimal @default(0) @db.Decimal(10, 2)
  /// Saldo que DEBERÍA haber en el cajón (fondo + cobrado − retirado), congelado
  /// al recoger. Null en arqueos anteriores al saldo de caja, o cuando la sede
  /// no tiene fondo de partida fiable.
  saldoEsperado     Decimal? @map("saldo_esperado") @db.Decimal(10, 2)

  /// Quién apartó el efectivo y cuándo lo declaró. El arqueo es de la tienda
  /// (uno por semana), así que si lo declara otra persona esto refleja la
  /// última: es a quien se le pregunta si algo no cuadra.
  declaradoPorId String?
  declaradoPor   User?     @relation("ArqueoDeclaradoPor", fields: [declaradoPorId], references: [id])
  declaradoEn    DateTime?
  /// Observaciones de quien lo declara ("faltan 20 € que puse de cambio").
  notas          String?

  /// "pendiente" | "recogido"
  estado        String    @default("pendiente")
  recogidoPorId String?
  recogidoPor   User?     @relation("ArqueoRecogidoPor", fields: [recogidoPorId], references: [id])
  recogidoEn    DateTime?
  /// Efectivo que se lleva quien recoge, si no es todo lo declarado (deja
  /// fondo de caja, o el sobre no cuadra). Null = se lleva lo declarado.
  efectivoRecogido Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tiendaId, semana])
  @@index([estado])
}

/// Importes que constan facturados en el sistema del operador, importados desde
/// su Excel (ticket 4b8e1d05). Sirven para cuadrar lo que los empleados declaran
/// haber vendido con lo que de verdad se metió a facturar: una venta declarada
/// que nunca se tramitó no aparece aquí, y un importe facturado sin venta
/// declarada tampoco cuadra.
///
/// Mismo planteamiento que `MovimientoBanco`, y a propósito: son dos fuentes
/// externas que se cruzan igual, por tienda y día.
model MovimientoFacturacion {
  id          String   @id @default(cuid())
  tiendaId    String?
  tienda      Tienda?  @relation(fields: [tiendaId], references: [id], onDelete: SetNull)
  fecha       DateTime @db.Date
  importe     Decimal  @db.Decimal(10, 2)
  concepto    String?
  /// Referencia en el export, para no importar dos veces lo mismo.
  referencia  String?
  importadoEn DateTime @default(now())

  @@unique([referencia])
  @@index([tiendaId, fecha])
}

/// Movimientos del banco importados desde Excel, para cuadrar los cobros con
/// datáfono. La conciliación compara estos importes con la suma de `tarjeta`
/// de los cierres de caja, por tienda y día.
model MovimientoBanco {
  id          String   @id @default(cuid())
  tiendaId    String?
  tienda      Tienda?  @relation(fields: [tiendaId], references: [id], onDelete: SetNull)
  fecha       DateTime @db.Date
  importe     Decimal  @db.Decimal(10, 2)
  concepto    String?
  /// Referencia del movimiento en el extracto, para no importar dos veces.
  referencia  String?
  importadoEn DateTime @default(now())

  @@unique([referencia])
  @@index([tiendaId, fecha])
}
